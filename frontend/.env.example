# Base da API usada pelo navegador. Em desenvolvimento, "/api/v1" passa pelo proxy do Vite.
# Atenção: toda variável VITE_* é embutida no bundle público. Nunca coloque segredos aqui.
VITE_API_BASE_URL=/api/v1

# Somente para o servidor de desenvolvimento (não vai para o bundle): destino do proxy /api e /uploads.
API_PROXY_TARGET=http://localhost:3333
