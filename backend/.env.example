# Ambiente de execução: development | test | production
NODE_ENV=development

# Porta HTTP da API
PORT=3333

# Conexão PostgreSQL (mesmas credenciais do docker-compose.yml)
DATABASE_URL="postgresql://cardapio:cardapio@localhost:5432/cardapio_digital?schema=public"

# Banco exclusivo dos testes de integração (obrigatório para `npm test`; o nome deve conter
# "test"). Os testes criam e removem dados: nunca aponte para o banco de desenvolvimento.
TEST_DATABASE_URL="postgresql://cardapio:cardapio@localhost:5432/cardapio_digital_test?schema=public"

# Origens autorizadas para CORS, separadas por vírgula.
# Vazio = somente mesma origem (em desenvolvimento o Vite faz proxy de /api, então não é necessário).
CORS_ORIGINS=

# Endereço público do frontend. Base da URL do cardápio no QR Code (APP_PUBLIC_URL/cardapio/slug)
# e única origem aceita em requisições que alteram dados.
APP_PUBLIC_URL=http://localhost:5173

# Nome do cookie de sessão administrativa (HttpOnly) e validade da sessão em horas
SESSION_COOKIE_NAME=cd_session
SESSION_TTL_HOURS=12

# Cookie da sessão dos operadores do backoffice da plataforma (/backoffice)
PLATFORM_SESSION_COOKIE_NAME=cd_platform_session

# Armazenamento de imagens. Nesta etapa existe apenas o driver "local".
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage/uploads

# Tamanho máximo de cada imagem enviada (fotos e logotipo), em bytes. Padrão: 5 MB.
UPLOAD_MAX_BYTES=5242880

# Usuário administrativo criado pelo seed do restaurante de demonstração.
# Se SEED_ADMIN_PASSWORD ficar vazio, o seed não cria o usuário.
SEED_ADMIN_EMAIL=admin@demo.local
SEED_ADMIN_PASSWORD=

# Operador do backoffice criado pelo seed. Vazio = não cria.
# Em produção, use: PLATFORM_ADMIN_PASSWORD=... npm run platform:create-admin -w backend -- --email=...
SEED_PLATFORM_ADMIN_EMAIL=operador@demo.local
SEED_PLATFORM_ADMIN_PASSWORD=
