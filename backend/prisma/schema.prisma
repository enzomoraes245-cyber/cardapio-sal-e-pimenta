// Modelagem inicial do Cardápio Digital (MVP).
// Convenções: ids UUID, tabelas e colunas em snake_case, timestamps em todas as entidades de negócio.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Estabelecimento (tenant). Todo dado de negócio pertence a exatamente um restaurante.
model Restaurant {
  id               String           @id @default(uuid()) @db.Uuid
  /// Identificador público e estável usado na URL do cardápio e no QR Code.
  slug             String           @unique @db.VarChar(80)
  name             String           @db.VarChar(120)
  /// Suspenso (DEC-006): retaguarda e cardápio público bloqueados; slug e QR Code preservados.
  status           RestaurantStatus @default(ACTIVE)
  suspendedAt      DateTime?        @map("suspended_at") @db.Timestamptz(3)
  suspensionReason String?          @map("suspension_reason") @db.VarChar(300)
  /// Contato do estabelecimento para a plataforma (uso interno; nunca aparece no cardápio).
  contactPhone     String?          @map("contact_phone") @db.VarChar(20)
  contactEmail     String?          @map("contact_email") @db.VarChar(254)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  adminUsers    AdminUser[]
  categories    Category[]
  products      Product[]
  customization RestaurantCustomization?
  features      RestaurantFeature[]
  subscription  Subscription?
  invoices      Invoice[]
  auditEvents   AuditEvent[]

  @@index([status])
  @@map("restaurants")
}

enum RestaurantStatus {
  ACTIVE
  SUSPENDED
}

/// Módulos liberáveis por restaurante (DEC-006).
enum FeatureKey {
  CUSTOMIZATION
  QRCODE
  REALTIME
  PRODUCT_MODAL
}

/// Ausência de linha = módulo liberado. O backoffice grava todas as chaves ao alterar.
model RestaurantFeature {
  restaurantId String     @map("restaurant_id") @db.Uuid
  feature      FeatureKey
  enabled      Boolean
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([restaurantId, feature])
  @@map("restaurant_features")
}

/// Assinatura mensal do restaurante (cobrança manual, sem gateway).
model Subscription {
  restaurantId  String   @id @map("restaurant_id") @db.Uuid
  monthlyAmount Decimal  @map("monthly_amount") @db.Decimal(10, 2)
  /// Dia de vencimento das faturas (1 a 28, válido em todos os meses).
  dueDay        Int      @map("due_day")
  startedAt     DateTime @map("started_at") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

enum InvoiceStatus {
  OPEN
  PAID
  CANCELED
}

/// Fatura mensal. "Vencida" = OPEN com due_date no passado (calculado, não gravado).
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  restaurantId   String        @map("restaurant_id") @db.Uuid
  /// Primeiro dia do mês de referência.
  referenceMonth DateTime      @map("reference_month") @db.Date
  amount         Decimal       @db.Decimal(10, 2)
  dueDate        DateTime      @map("due_date") @db.Date
  status         InvoiceStatus @default(OPEN)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, referenceMonth])
  @@index([status, dueDate])
  @@map("invoices")
}

/// Operador do backoffice da plataforma. Não pertence a nenhum restaurante.
model PlatformAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            PlatformSession[]
  passwordResetTokens PasswordResetToken[]

  @@map("platform_admins")
}

model PlatformSession {
  id              String   @id @default(uuid()) @db.Uuid
  platformAdminId String   @map("platform_admin_id") @db.Uuid
  tokenHash       String   @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  platformAdmin PlatformAdmin @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([platformAdminId])
  @@index([expiresAt])
  @@map("platform_sessions")
}

/// Usuário da retaguarda. Pertence a um único restaurante.
model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  restaurantId String    @map("restaurant_id") @db.Uuid
  name         String    @db.VarChar(120)
  /// Único globalmente: o login identifica o restaurante a partir do usuário.
  email        String    @unique @db.VarChar(254)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  /// Acesso bloqueado pelo backoffice: não entra na retaguarda até ser desbloqueado.
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant          Restaurant           @relation(fields: [restaurantId], references: [id])
  sessions            AdminSession[]
  passwordResetTokens PasswordResetToken[]

  @@index([restaurantId])
  @@map("admin_users")
}

/// Sessão administrativa. Guarda apenas o hash SHA-256 do token enviado no cookie HttpOnly.
model AdminSession {
  id          String   @id @default(uuid()) @db.Uuid
  adminUserId String   @map("admin_user_id") @db.Uuid
  tokenHash   String   @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([expiresAt])
  @@map("admin_sessions")
}

model Category {
  id           String   @id @default(uuid()) @db.Uuid
  restaurantId String   @map("restaurant_id") @db.Uuid
  name         String   @db.VarChar(80)
  /// Ordem de exibição no cardápio (crescente).
  position     Int      @default(0)
  /// Categoria oculta: ela e seus produtos saem do cardápio público; nada é apagado.
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  products   Product[]

  /// Alvo da FK composta de Product: garante que produto e categoria sejam do mesmo restaurante.
  @@unique([id, restaurantId])
  @@index([restaurantId, position])
  @@map("categories")
}

model Product {
  id                  String   @id @default(uuid()) @db.Uuid
  restaurantId        String   @map("restaurant_id") @db.Uuid
  categoryId          String   @map("category_id") @db.Uuid
  name                String   @db.VarChar(120)
  /// Exibida na listagem do cardápio.
  shortDescription    String?  @map("short_description") @db.VarChar(300)
  /// Exibida no modal de detalhes.
  detailedDescription String?  @map("detailed_description") @db.VarChar(2000)
  /// Valor monetário com precisão decimal (nunca ponto flutuante).
  price               Decimal  @db.Decimal(10, 2)
  /// Chave da foto no armazenamento. Obrigatória no cadastro (validada na aplicação);
  /// anulável no banco apenas por compatibilidade, e o cardápio público ignora produtos sem foto.
  imageKey            String?  @map("image_key") @db.VarChar(255)
  /// Situação cadastral: inativo nunca aparece no cardápio.
  isActive            Boolean  @default(true) @map("is_active")
  /// Situação operacional (ex.: acabou no dia): indisponível não aparece no cardápio.
  isAvailable         Boolean  @default(true) @map("is_available")
  /// Ordem de exibição dentro da categoria (crescente).
  position            Int      @default(0)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])
  category   Category   @relation(fields: [categoryId, restaurantId], references: [id, restaurantId])

  @@index([categoryId, restaurantId, position])
  @@index([restaurantId, isActive, isAvailable])
  @@map("products")
}

/// Identidade visual do restaurante (relação 1:1). O nome fica em Restaurant.
model RestaurantCustomization {
  restaurantId   String   @id @map("restaurant_id") @db.Uuid
  logoKey        String?  @map("logo_key") @db.VarChar(255)
  /// Cores em hexadecimal (#RRGGBB).
  primaryColor   String?  @map("primary_color") @db.Char(7)
  secondaryColor String?  @map("secondary_color") @db.Char(7)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_customizations")
}

/// Pedido de redefinição de senha por e-mail. Só o hash do token fica no banco; uso único.
/// Pertence a um administrador de restaurante OU a um operador do backoffice (CHECK no banco).
model PasswordResetToken {
  id              String    @id @default(uuid()) @db.Uuid
  adminUserId     String?   @map("admin_user_id") @db.Uuid
  platformAdminId String?   @map("platform_admin_id") @db.Uuid
  tokenHash       String    @unique @map("token_hash") @db.Char(64)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  adminUser     AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  platformAdmin PlatformAdmin? @relation(fields: [platformAdminId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([platformAdminId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

enum AuditActorType {
  PLATFORM_ADMIN
  RESTAURANT_ADMIN
  SYSTEM
}

/// Histórico de ações relevantes: autor, data/hora, motivo e detalhes (antes/depois).
/// Gravado na mesma transação da alteração; a aplicação nunca altera nem apaga registros.
model AuditEvent {
  id           String         @id @default(uuid()) @db.Uuid
  occurredAt   DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType    AuditActorType @map("actor_type")
  /// Operador ou administrador autor da ação (sem FK: pode vir de duas tabelas).
  actorId      String?        @map("actor_id") @db.Uuid
  /// Nome do autor no momento da ação, para o histórico continuar legível.
  actorName    String?        @map("actor_name") @db.VarChar(120)
  restaurantId String?        @map("restaurant_id") @db.Uuid
  action       String         @db.VarChar(60)
  entityType   String?        @map("entity_type") @db.VarChar(40)
  entityId     String?        @map("entity_id") @db.Uuid
  reason       String?        @db.VarChar(300)
  metadata     Json?

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([restaurantId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@map("audit_events")
}

/// Chave de idempotência de um cadastro (cabeçalho Idempotency-Key): repetir o envio com a mesma
/// chave devolve o registro já criado em vez de duplicá-lo. Removida depois de 24 h.
model IdempotencyKey {
  scope      String   @db.VarChar(60)
  /// Restaurante (painel) ou operador (backoffice) que fez o cadastro.
  ownerId    String   @map("owner_id") @db.Uuid
  key        String   @db.VarChar(100)
  resourceId String?  @map("resource_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([scope, ownerId, key])
  @@index([createdAt])
  @@map("idempotency_keys")
}
